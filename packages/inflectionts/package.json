{
  "name": "inflectionts",
  "version": "0.1.0",
  "description": "Effect v4 TypeScript port of jaraco/inflect for English plurals, singulars, ordinals, indefinite articles, and number words",
  "keywords": [
    "a-an",
    "bun",
    "effect",
    "effect-ts",
    "english",
    "indefinite-article",
    "inflect",
    "inflection",
    "nlp",
    "number-to-words",
    "ordinal",
    "plural",
    "pluralize",
    "singular",
    "singularize",
    "typescript"
  ],
  "homepage": "https://github.com/ethan-wickstrom/inflectionts#readme",
  "bugs": {
    "url": "https://github.com/ethan-wickstrom/inflectionts/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethan-wickstrom/inflectionts.git",
    "directory": "packages/inflectionts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [],
  "imports": {
    "#internal/*": "./src/internal/*.ts"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./index": null,
    "./*/index": null
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "import": "./dist/*.js"
      },
      "./internal/*": null,
      "./index": null,
      "./*/index": null
    },
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:types && bun run build:js",
    "build:js": "bun build ./src/index.ts ./src/Errors.ts ./src/Schema.ts ./src/Inflector.ts --outdir ./dist --root ./src --splitting --target=node --format=esm --packages=external --sourcemap=linked",
    "build:types": "bun run --bun tsc -b tsconfig.src.json",
    "pack": "bun scripts/pack.ts",
    "docs": "PATH=\"$PWD/scripts/bin:$PATH\" bun run --bun docgen && bun scripts/check-docs.ts"
  },
  "devDependencies": {
    "@effect/docgen": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@types/bun": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.1.4"
  }
}
