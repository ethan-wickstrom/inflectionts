{
  "name": "inflectionts",
  "version": "0.1.0",
  "description": "Effect v4 TypeScript port of jaraco/inflect for English plurals, singulars, ordinals, indefinite articles, and number words",
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./internal/*": null,
    "./index": null,
    "./*/index": null
  },
  "publishConfig": {
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "import": "./dist/*.js"
      },
      "./internal/*": null,
      "./index": null,
      "./*/index": null
    },
    "access": "public"
  },
  "scripts": {
    "build": "bun run build:types && bun run build:js",
    "build:js": "bun build ./src/index.ts ./src/Errors.ts ./src/Schema.ts ./src/Inflector.ts --outdir ./dist --root ./src --splitting --target=node --format=esm --packages=external --sourcemap=linked",
    "build:types": "bun run --bun tsc -b tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "effect": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "effect": "catalog:"
  }
}
