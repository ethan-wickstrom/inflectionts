#!/usr/bin/env bash
set -euo pipefail

# bun run resolves the workspace's node_modules from the cwd, so anchor to the
# repository root before dispatching; editors and tools may spawn this shim from
# anywhere.
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"

if command -v oxfmt-lsp >/dev/null 2>&1; then
  exec oxfmt-lsp "$@"
fi

for arg in "$@"; do
  case "$arg" in
    --lsp | --version | -V | --help | -h)
      exec bun run --bun oxfmt "$@"
      ;;
  esac
done
exec bun run --bun oxfmt --lsp "$@"
